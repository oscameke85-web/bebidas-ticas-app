@model BebidasTicasPedidos.Models.Pedido

@{
    ViewData["Title"] = "Detalle del Pedido";
}

<h1>Detalle del Pedido</h1>

<div class="card mb-4">
    <div class="card-body">
        <p><strong>Cliente:</strong> @Model.Cliente?.Nombre</p>
        <p><strong>Fecha:</strong> @Model.Fecha.ToString("dd/MM/yyyy HH:mm")</p>
        <p><strong>Estado:</strong> @Model.Estado</p>
        <p><strong>Método de pago:</strong> @Model.MetodoPago</p>
        <p><strong>Observaciones:</strong> @Model.Observaciones</p>
    </div>
</div>

<h4>Productos</h4>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Producto</th>
            <th>Cantidad</th>
            <th>Precio unitario</th>
            <th>Subtotal</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.DetallePedido)
        {
            <tr>
                <td>@item.Producto?.Nombre</td>
                <td>@item.Cantidad</td>
                <td>₡@item.PrecioUnitario</td>
                <td>₡@item.Subtotal</td>
            </tr>
        }
    </tbody>
</table>

<h3>Total: ₡@Model.Total</h3>

<a asp-action="Index" class="btn btn-secondary">Volver</a>
