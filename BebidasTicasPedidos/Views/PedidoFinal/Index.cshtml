@model List<BebidasTicasPedidos.ViewModels.PedidoFinalItemViewModel>

@{
    ViewData["Title"] = "Pedido Final";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
    <h1 class="mb-3 mb-md-0">Pedido Final</h1>
    <a asp-action="Limpiar" class="btn btn-danger">Limpiar pedido</a>
</div>

<div class="card mb-4">
    <div class="card-header bg-success text-white">
        Agregar producto
    </div>

    <div class="card-body">
        <form asp-action="AgregarProducto" method="post">
            @Html.AntiForgeryToken()

            <div class="row">
                <div class="col-md-7 mb-3">
                    <label class="form-label">Producto</label>
                    <select name="productoId" class="form-control" asp-items="ViewBag.Productos">
                        <option value="">Seleccione un producto</option>
                    </select>
                </div>

                <div class="col-md-3 mb-3">
                    <label class="form-label">Cantidad</label>
                    <input type="number" name="cantidad" class="form-control" min="1" placeholder="Cantidad" />
                </div>

                <div class="col-md-2 mb-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-success w-100">Agregar</button>
                </div>
            </div>
        </form>
    </div>
</div>

@if (Model.Any())
{
    <div class="card">
        <div class="card-header bg-dark text-white">
            Resumen del pedido final
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th>Cantidad</th>
                            <th>Precio unitario</th>
                            <th>Subtotal</th>
                            <th>Acción</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Producto</td>
                                <td>@item.Cantidad</td>
                                <td>₡@item.PrecioUnitario.ToString("N2")</td>
                                <td>₡@item.Subtotal.ToString("N2")</td>
                                <td>
                                    <a asp-action="EliminarProducto"
                                       asp-route-productoId="@item.ProductoId"
                                       class="btn btn-danger btn-sm">
                                        Eliminar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <hr />

            <div class="text-end">
                <h5>Total de unidades: <strong>@ViewBag.TotalUnidades</strong></h5>
                <h4>Total general: <strong>₡@ViewBag.TotalDinero.ToString("N2")</strong></h4>
            </div>

            <form asp-action="GuardarPedidoFinal" method="post" class="text-end mt-3">
                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-success btn-lg">
                    Guardar Pedido Final
                </button>
            </form>
        </div>
    </div>
}
else
{
    <div class="alert alert-info">
        Aún no has agregado productos al pedido final.
    </div>
}
