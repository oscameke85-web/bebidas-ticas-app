@model BebidasTicasPedidos.Models.Producto

@{
    ViewData["Title"] = "Eliminar Producto";
}

<h1>Eliminar Producto</h1>

<div class="alert alert-danger">
    ¿Seguro que deseas eliminar este producto?
</div>

<div class="card">
    <div class="card-body">
        <p><strong>Nombre:</strong> @Model.Nombre</p>
        <p><strong>Categoría:</strong> @Model.Categoria</p>
        <p><strong>Presentación:</strong> @Model.Presentacion</p>
        <p><strong>Precio:</strong> ₡@Model.Precio</p>
    </div>
</div>

<br />

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
