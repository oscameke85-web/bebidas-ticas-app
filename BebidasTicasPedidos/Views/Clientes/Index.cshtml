@model IEnumerable<BebidasTicasPedidos.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
    <h1 class="mb-3 mb-md-0">Clientes</h1>
    <a asp-action="Create" class="btn btn-success">Agregar Cliente</a>
</div>

<div class="d-none d-md-block">
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Teléfono</th>
                    <th>Correo</th>
                    <th>Zona</th>
                    <th>Tipo</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cliente in Model)
                {
                    <tr>
                        <td>@cliente.Nombre</td>
                        <td>@cliente.Telefono</td>
                        <td>@cliente.Correo</td>
                        <td>@cliente.Zona</td>
                        <td>@cliente.TipoCliente</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@cliente.Id" class="btn btn-info btn-sm">Ver</a>
                            <a asp-action="Edit" asp-route-id="@cliente.Id" class="btn btn-warning btn-sm">Editar</a>
                            <a asp-action="Delete" asp-route-id="@cliente.Id" class="btn btn-danger btn-sm">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="d-md-none">
    @foreach (var cliente in Model)
    {
        <div class="cliente-card">
            <h4>@cliente.Nombre</h4>

            <p><strong>Teléfono:</strong> @cliente.Telefono</p>
            <p><strong>Correo:</strong> @cliente.Correo</p>
            <p><strong>Zona:</strong> @cliente.Zona</p>
            <p><strong>Tipo:</strong> @cliente.TipoCliente</p>

            <div class="cliente-actions">
                <a asp-action="Details" asp-route-id="@cliente.Id" class="btn btn-info btn-sm">Ver</a>
                <a asp-action="Edit" asp-route-id="@cliente.Id" class="btn btn-warning btn-sm">Editar</a>
                <a asp-action="Delete" asp-route-id="@cliente.Id" class="btn btn-danger btn-sm">Eliminar</a>
            </div>
        </div>
    }
</div>